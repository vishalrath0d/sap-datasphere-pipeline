# Copy to .env (git-ignored), fill in, then load into your shell:
#   set -a; source .env; set +a

DS_MODE=real

# ---------------------------------------------------------------------------------------------
# A) SAP trial tenant (no App Integration -> no OAuth client) - passcode mode, laptop only
#    Start the passcode browser once:  bash tools/passcode/chrome-session.sh   (sign in there)
# ---------------------------------------------------------------------------------------------
DS_HOST=https://academydatasphere-1.ap11.hcs.cloud.sap
DS_AUTH=passcode
# computed by `datasphere config passcode-url --host $DS_HOST`; set here to skip that call
DS_PASSCODE_URL=https://academydatasphere-1.authentication.ap11.hana.ondemand.com/passcode
# chrome = automatic (default) | prompt = you paste each code
DS_PASSCODE_SOURCE=chrome
# Optional: sign in automatically (first request and whenever the session expires), in a
# background tab - no focus change. POC only: .env is git-ignored, but it is a plain-text
# password on disk. Production has no password at all (OAuth technical user, section B).
# DS_USER = what you type on the SAP login page; use the email (the field validates email format)
DS_AUTO_LOGIN=1
DS_USER=ge383881@sapexperienceacademy.com
DS_PASSWORD=

# ---------------------------------------------------------------------------------------------
# B) Tenant where you are admin (App Integration exists) - OAuth, works in CI too
#    Comment out DS_AUTH above. Values from System > Administration > App Integration.
# ---------------------------------------------------------------------------------------------
# DS_AUTH_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/authorize
# DS_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
# Interactive Usage client (redirect http://localhost:8080) for scripts/login-interactive.sh:
# DS_UI_CLIENT_ID=
# DS_UI_CLIENT_SECRET=
# Technical User client (client credentials) - what CI uses:
# DS_CLIENT_ID=
# DS_CLIENT_SECRET=
# DS_SKIP_LOGIN=1
