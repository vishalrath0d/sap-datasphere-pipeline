#!/usr/bin/env python3
"""A tiny SIMULATOR of the SAP Datasphere CLI, so the whole pipeline can run with no tenant.

It is NOT the SAP CLI. It mimics only the calls this repo makes:

  datasphere -v
  datasphere login [--options-file F | --secrets-file F] [--force] | config cache init | config host set URL
  datasphere objects <type> list   --space S [--technical-names A,B] [--top N] [--skip N] [--output F]
  datasphere objects <type> read   --space S --technical-name N [--accept FMT] [--output F]
  datasphere objects <type> create --space S [--technical-name N] --file-path F
  datasphere objects <type> update --space S [--technical-name N] --file-path F
  datasphere objects <type> delete --space S --technical-name N

State lives in $MOCK_DS_STATE/<tenant>/<space>/<type>/<NAME>.json (default ./.mock-state).
Like the real service it refuses to deploy a view whose source table/view does not exist yet,
which is what makes dependency ordering visible in the demo. Like the real CLI, `list` returns at
most --top rows (default 25, max 200). MOCK_DS_NOISE=1 prints a warning line on stdout first, the
way the real CLI does when the CLI or Node version is unsupported.
"""
import json
import os
import re
import sys
from pathlib import Path

BOOL_FLAGS = {"--no-deploy", "--verbose", "-V", "--force", "-F", "-h", "--help", "-v", "--version", "--save-anyway"}


def fail(msg, code=1):
    print("Error: %s" % msg, file=sys.stderr)
    sys.exit(code)


def parse(argv):
    pos, opts, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("-") and len(a) > 1:
            if "=" in a:
                k, v = a.split("=", 1)
                opts[k] = v
            elif a in BOOL_FLAGS:
                opts[a] = True
            else:
                if i + 1 >= len(argv):
                    fail("option %s needs a value" % a)
                opts[a] = argv[i + 1]
                i += 1
        else:
            pos.append(a)
        i += 1
    return pos, opts


def opt(opts, *names):
    for n in names:
        if n in opts:
            return opts[n]
    return None


def state_root():
    host = os.environ.get("DS_HOST") or "mock-tenant"
    tenant = re.sub(r"[^A-Za-z0-9._-]+", "_", host)
    return Path(os.environ.get("MOCK_DS_STATE", ".mock-state")) / tenant


# --- minimal CSN dependency detection (mirrors scripts/py/dslib.py) -------

def from_refs(node):
    out = []
    if isinstance(node, list):
        for x in node:
            out += from_refs(x)
    elif isinstance(node, dict):
        ref = node.get("ref")
        if isinstance(ref, list) and ref and isinstance(ref[0], str):
            out.append(ref[0])
        if "join" in node:
            for a in node.get("args") or []:
                out += from_refs(a)
        if "SELECT" in node or "SET" in node:
            out += query_refs(node)
    return out


def query_refs(q):
    out = []
    if isinstance(q, dict):
        if isinstance(q.get("SELECT"), dict):
            out += from_refs(q["SELECT"].get("from"))
        if isinstance(q.get("SET"), dict):
            for a in q["SET"].get("args") or []:
                out += query_refs(a)
    return out


def noise():
    if os.environ.get("MOCK_DS_NOISE") == "1":
        print("WARNING: (mock) your local CLI installation is outdated - this line is on stdout on purpose")


def emit(opts, text):
    """Write to --output FILE if given, else stdout (what the real CLI does)."""
    out = opt(opts, "--output", "-o")
    if out and out is not True:
        Path(out).write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)


def objects_cmd(pos, opts):
    if len(pos) < 3:
        fail("usage: datasphere objects <type> <list|read|create|update|delete> --space S ...")
    otype, action = pos[1], pos[2]
    space = opt(opts, "--space", "-S")
    if not space:
        fail("missing required option --space")
    sdir = state_root() / space
    tdir = sdir / otype
    name = opt(opts, "--technical-name", "-N")

    noise()
    if action == "list":
        names = sorted(p.stem for p in tdir.glob("*.json")) if tdir.is_dir() else []
        wanted = opt(opts, "--technical-names")
        if wanted:
            names = [n for n in names if n in wanted.split(",")]
        top = min(int(opt(opts, "--top") or 25), 200)
        skip = int(opt(opts, "--skip") or 0)
        names = names[skip:skip + top]
        emit(opts, json.dumps([{"technicalName": n} for n in names], indent=2) + "\n")
        return

    if action in ("read", "delete"):
        if not name:
            fail("missing required option --technical-name")
        f = tdir / ("%s.json" % name)
        if not f.exists():
            fail("%s '%s' not found in space %s" % (otype, name, space))
        if action == "read":
            emit(opts, f.read_text(encoding="utf-8"))
        else:
            f.unlink()
            print("deleted %s/%s from %s" % (otype, name, space), file=sys.stderr)
        return

    if action in ("create", "update"):
        fp = opt(opts, "--file-path", "--filePath", "-f")
        if not fp:
            fail("missing required option --file-path")
        try:
            doc = json.loads(Path(fp).read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            fail("cannot read definition file %s: %s" % (fp, exc))
        defs = doc.get("definitions") if isinstance(doc, dict) else None
        if not isinstance(defs, dict) or not defs:
            fail("definition file has no 'definitions' object")
        name = name or next(iter(defs))
        if name not in defs:
            fail("technical name %s not found in definitions (%s)" % (name, ", ".join(defs)))
        target = tdir / ("%s.json" % name)
        exists_anywhere = any((d / ("%s.json" % name)).exists() for d in sdir.glob("*") if d.is_dir())
        if action == "create" and exists_anywhere:
            fail("object '%s' already exists in space %s" % (name, space))
        if action == "update" and not target.exists():
            fail("%s '%s' does not exist in space %s - use create" % (otype, name, space))
        external = set(filter(None, os.environ.get("MOCK_DS_EXTERNAL", "").split(",")))
        targets = {el.get("target") for el in (defs[name].get("elements") or {}).values()
                   if isinstance(el, dict) and el.get("type") in ("cds.Association", "cds.Composition")}
        for dep in sorted(set(query_refs(defs[name].get("query"))) | {t for t in targets if isinstance(t, str)}):
            if dep == name or dep in external or "." in dep:
                continue
            if not any((d / ("%s.json" % dep)).exists() for d in sdir.glob("*") if d.is_dir()):
                fail("deployment of '%s' failed: source '%s' not found in space %s (deploy it first)" % (name, dep, space))
        tdir.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
        print("%s %s/%s in space %s (deployed)" % ("created" if action == "create" else "updated", otype, name, space), file=sys.stderr)
        return

    fail("unknown objects action '%s'" % action)


def main():
    pos, opts = parse(sys.argv[1:])
    if opt(opts, "-v", "--version"):
        print("mock-datasphere-cli 0.1 (simulator - not the SAP CLI)")
        return
    if not pos:
        fail("no command given")
    if pos[0] == "login":
        for key in ("--options-file", "--secrets-file"):
            f = opt(opts, key)
            if f:
                try:
                    json.loads(Path(f).read_text(encoding="utf-8"))
                except (OSError, ValueError) as exc:
                    fail("cannot read %s %s: %s" % (key, f, exc))
        print("mock: logged in (no real authentication performed)", file=sys.stderr)
    elif pos[0] == "config":
        sf = opt(opts, "--secrets-file", "-s")
        if sf and not Path(sf).is_file():
            fail("secrets file not found: %s" % sf)
        print("mock: config %s ok" % " ".join(pos[1:]), file=sys.stderr)
    elif pos[0] == "objects":
        objects_cmd(pos, opts)
    else:
        fail("mock CLI does not implement '%s'" % pos[0])


if __name__ == "__main__":
    main()
